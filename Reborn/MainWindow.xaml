<Window
    x:Class="Reborn.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Reborn.Controls"
    Title="Reborn Music">

    <!-- Layout measured from Groove 10.20112 (Windows 10): 32px title bar, 320px acrylic pane,
         black content, 90px accent-tinted player bar across the full width. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="90" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PaneColumn" Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Content (black), starts under the title bar -->
        <Grid Grid.Column="1" Grid.RowSpan="2" Background="{ThemeResource ContentBackground}">
            <Frame x:Name="ContentFrame" Margin="0,32,0,0" Navigated="ContentFrame_Navigated" />
        </Grid>

        <!-- Pane (transparent: the window acrylic shows through) -->
        <Grid x:Name="Pane" Grid.Row="1" Background="{ThemeResource PaneTint}">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button x:Name="HamburgerButton" Style="{StaticResource BareButton}" Width="48" Height="50"
                    HorizontalAlignment="Left" Click="Hamburger_Click" AutomationProperties.Name="Меню">
                <FontIcon Glyph="&#xE700;" FontSize="20" />
            </Button>

            <!-- Search box: dark field, magnifier on the right -->
            <Grid x:Name="SearchField" Grid.Row="1" Height="35" Margin="12,3,13,6"
                  Background="{ThemeResource SearchBoxBackground}" BorderThickness="2" BorderBrush="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="Поиск" FontSize="15" Padding="10,5,4,0"
                         VerticalAlignment="Center" BorderThickness="0" Background="Transparent"
                         KeyDown="Search_KeyDown" GotFocus="Search_GotFocus" LostFocus="Search_LostFocus" />
                <Button Grid.Column="1" Style="{StaticResource BareButton}" Click="SearchButton_Click"
                        AutomationProperties.Name="Найти">
                    <FontIcon Glyph="&#xE721;" FontSize="16" />
                </Button>
            </Grid>
            <Button x:Name="SearchIconButton" Grid.Row="1" Style="{StaticResource BareButton}" Width="48" Height="44"
                    HorizontalAlignment="Left" Visibility="Collapsed" Click="SearchIcon_Click" AutomationProperties.Name="Поиск">
                <FontIcon Glyph="&#xE721;" FontSize="16" />
            </Button>

            <StackPanel Grid.Row="2">
                <Button x:Name="NavMusic" Style="{StaticResource PaneItem}" Tag="music" Click="Nav_Click"
                        AutomationProperties.Name="Моя музыка">
                    <Grid>
                        <Rectangle x:Name="IndMusic" Width="4" HorizontalAlignment="Left" Margin="0,1"
                                   Fill="{StaticResource GrooveAccentText}" Visibility="Collapsed" />
                        <FontIcon x:Name="MusicGlyph" Glyph="&#xE940;" FontSize="16" Width="48" HorizontalAlignment="Left" />
                        <TextBlock Text="Моя музыка" Margin="48,0,0,0" VerticalAlignment="Center" FontSize="15" />
                    </Grid>
                </Button>
                <Button x:Name="NavRecent" Style="{StaticResource PaneItem}" Tag="recent" Click="Nav_Click"
                        AutomationProperties.Name="Последние">
                    <Grid>
                        <Rectangle x:Name="IndRecent" Width="4" HorizontalAlignment="Left" Margin="0,1"
                                   Fill="{StaticResource GrooveAccentText}" Visibility="Collapsed" />
                        <FontIcon Glyph="&#xE823;" FontSize="16" Width="48" HorizontalAlignment="Left" />
                        <TextBlock Text="Последние" Margin="48,0,0,0" VerticalAlignment="Center" FontSize="15" />
                    </Grid>
                </Button>
                <Button x:Name="NavNow" Style="{StaticResource PaneItem}" Tag="now" Click="Nav_Click"
                        AutomationProperties.Name="Сейчас играет">
                    <Grid>
                        <Rectangle x:Name="IndNow" Width="4" HorizontalAlignment="Left" Margin="0,1"
                                   Fill="{StaticResource GrooveAccentText}" Visibility="Collapsed" />
                        <FontIcon x:Name="NowGlyph" Glyph="&#xE93D;" FontSize="16" Width="48" HorizontalAlignment="Left" />
                        <TextBlock Text="Сейчас играет" Margin="48,0,0,0" VerticalAlignment="Center" FontSize="15" />
                    </Grid>
                </Button>
                <Rectangle Height="1" Margin="12,0,13,0" Fill="{ThemeResource PaneSeparator}" />
                <Button x:Name="NavPlaylists" Style="{StaticResource PaneItem}" Tag="playlists" Click="Nav_Click"
                        AutomationProperties.Name="Плейлисты">
                    <Grid>
                        <Rectangle x:Name="IndPlaylists" Width="4" HorizontalAlignment="Left" Margin="0,1"
                                   Fill="{StaticResource GrooveAccentText}" Visibility="Collapsed" />
                        <FontIcon x:Name="PlaylistGlyph" Glyph="&#xE93F;" FontSize="16" Width="48" HorizontalAlignment="Left" />
                        <TextBlock Text="Плейлисты" Margin="48,0,0,0" VerticalAlignment="Center" FontSize="15" />
                    </Grid>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="4">
                <Rectangle Height="1" Margin="12,0,13,0" Fill="{ThemeResource PaneSeparator}" />
                <Button x:Name="NavSettings" Style="{StaticResource PaneItem}" Tag="settings" Click="Nav_Click"
                        AutomationProperties.Name="Настройки">
                    <Grid>
                        <Rectangle x:Name="IndSettings" Width="4" HorizontalAlignment="Left" Margin="0,1"
                                   Fill="{StaticResource GrooveAccentText}" Visibility="Collapsed" />
                        <FontIcon Glyph="&#xE713;" FontSize="16" Width="48" HorizontalAlignment="Left" />
                        <TextBlock Text="Настройки" Margin="48,0,0,0" VerticalAlignment="Center" FontSize="15" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Title bar (over both columns) -->
        <Grid x:Name="TitleBar" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackButton" Style="{StaticResource BareButton}" Width="48" Height="32"
                        Visibility="Collapsed" Click="Back_Click" AutomationProperties.Name="Назад">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <TextBlock x:Name="TitleText" Text="Reborn Music" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,1" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" AutomationProperties.Name="Свернуть">
                    <FontIcon Glyph="&#xE921;" FontSize="10" FontFamily="Segoe MDL2 Assets" />
                </Button>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" AutomationProperties.Name="Развернуть">
                    <FontIcon x:Name="MaxIcon" Glyph="&#xE922;" FontSize="10" FontFamily="Segoe MDL2 Assets" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="Close_Click" AutomationProperties.Name="Закрыть"
                        PointerEntered="Close_PointerEntered" PointerExited="Close_PointerExited">
                    <FontIcon Glyph="&#xE8BB;" FontSize="10" FontFamily="Segoe MDL2 Assets" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Player bar -->
        <Grid x:Name="PlayerBar" Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource GroovePlayerBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="NowInfo" Background="Transparent" Tapped="NowInfo_Tapped" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Background="#33000000">
                    <FontIcon Glyph="&#xE8D6;" FontSize="28" Opacity="0.5" Foreground="{StaticResource GroovePlayerForeground}" />
                    <Image x:Name="NowCover" Stretch="UniformToFill" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,12,4">
                    <TextBlock x:Name="NowTitle" FontSize="15" Foreground="{StaticResource GroovePlayerForeground}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NowArtist" FontSize="13" Margin="0,2,0,0" Foreground="{StaticResource GroovePlayerSecondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Width="436">
                <Grid.RowDefinitions>
                    <RowDefinition Height="63" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Button x:Name="ShuffleButton" Style="{StaticResource TransportButton}" Click="Shuffle_Click"
                            AutomationProperties.Name="Перемешать" ToolTipService.ToolTip="Перемешать: выкл.">
                        <FontIcon x:Name="ShuffleIcon" Glyph="&#xE8B1;" FontSize="16" />
                    </Button>
                    <Button x:Name="PrevButton" Style="{StaticResource TransportButton}" Click="Prev_Click"
                            AutomationProperties.Name="Назад" ToolTipService.ToolTip="Назад">
                        <FontIcon Glyph="&#xE892;" FontSize="21" />
                    </Button>
                    <Button x:Name="PlayButton" Style="{StaticResource TransportButton}" Width="50" Height="50" CornerRadius="25"
                            Margin="7,0" BorderThickness="1" BorderBrush="{ThemeResource PlayRing}" Click="Play_Click"
                            AutomationProperties.Name="PlayPause" ToolTipService.ToolTip="Воспроизвести">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="26" Margin="3,0,0,0" />
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource TransportButton}" Click="Next_Click"
                            AutomationProperties.Name="Next" ToolTipService.ToolTip="Далее">
                        <FontIcon Glyph="&#xE893;" FontSize="21" />
                    </Button>
                    <Button x:Name="RepeatButton" Style="{StaticResource TransportButton}" Click="Repeat_Click"
                            AutomationProperties.Name="Повтор" ToolTipService.ToolTip="Повтор: выкл.">
                        <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="16" />
                    </Button>
                </StackPanel>
                <Grid Grid.Row="1" Height="30" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PosText" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"
                               Foreground="{StaticResource GroovePlayerSecondary}" />
                    <c:GrooveSlider x:Name="SeekSlider" Grid.Column="1" ThumbOnHoverOnly="True" />
                    <TextBlock x:Name="DurText" Grid.Column="2" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{StaticResource GroovePlayerSecondary}" />
                </Grid>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,14,0,0">
                <Button x:Name="VolumeButton" Style="{StaticResource TransportButton}" Click="Mute_Click"
                        AutomationProperties.Name="Громкость" ToolTipService.ToolTip="Без звука">
                    <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="18" />
                </Button>
                <c:GrooveSlider x:Name="VolumeSlider" Width="100" Height="40" Margin="6,0,4,0" />
                <Button Style="{StaticResource TransportButton}" AutomationProperties.Name="Дополнительно" ToolTipService.ToolTip="Дополнительно">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedRight">
                            <MenuFlyoutItem Text="Сейчас играет" Click="NowPlaying_Click" />
                            <MenuFlyoutItem Text="Настройки" Click="SettingsMenu_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
