<Page
    x:Class="Reborn.Pages.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Reborn.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with blurred-looking art backdrop -->
        <Grid>
            <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.18" VerticalAlignment="Center" />
            <Grid Padding="40,28,24,28" ColumnSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="SquareArt" Width="220" Height="220" Background="{ThemeResource TilePlaceholder}">
                    <FontIcon Glyph="&#xE93C;" FontSize="64" Opacity="0.35" />
                    <Image x:Name="ArtImage" Stretch="UniformToFill" />
                </Grid>
                <Grid x:Name="RoundArt" Width="220" Height="220" Visibility="Collapsed">
                    <Ellipse Fill="{ThemeResource TilePlaceholder}" />
                    <TextBlock x:Name="InitialText" FontSize="72" FontWeight="SemiLight" Opacity="0.6"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush x:Name="RoundBrush" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                    <TextBlock x:Name="TitleText" Style="{StaticResource PageHeader}" TextWrapping="WrapWholeWords" MaxLines="2" />
                    <TextBlock x:Name="SubText" FontSize="16" Style="{StaticResource SecondaryText}" />
                    <TextBlock x:Name="InfoText" Style="{StaticResource SecondaryText}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                        <Button Style="{StaticResource AccentButtonStyle}" Click="PlayAll_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="Воспроизвести все" />
                            </StackPanel>
                        </Button>
                        <Button Click="Shuffle_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                <TextBlock Text="Перемешать" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <ListView x:Name="TrackList" Grid.Row="1" Padding="24,8,24,24"
                  SelectionMode="Single" DoubleTapped="Track_DoubleTapped" ContainerContentChanging="Stripe_ContainerContentChanging" KeyDown="Track_KeyDown"
                  ItemContainerStyle="{StaticResource StretchListItem}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:Track">
                    <Grid Height="44" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind NumberText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Artist}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind DurationText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
