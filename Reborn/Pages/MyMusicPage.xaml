<Page
    x:Class="Reborn.Pages.MyMusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Reborn.Models"
    NavigationCacheMode="Required"
    Background="Transparent">

    <!-- Groove: header at x=22 from the pane, pivot 20px with a 1px rule under it, filter row 13px -->
    <Grid Padding="22,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Header" Text="Моя музыка" Style="{StaticResource PageHeader}" Margin="0,0,0,10" />

        <Grid Grid.Row="1">
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource ContentSeparator}" />
            <StackPanel x:Name="Tabs" Orientation="Horizontal">
                <ToggleButton Content="Композиции" Style="{StaticResource PivotTab}" Click="Tab_Click" />
                <ToggleButton Content="Исполнители" Style="{StaticResource PivotTab}" Click="Tab_Click" />
                <ToggleButton Content="Альбомы" Style="{StaticResource PivotTab}" Click="Tab_Click" />
            </StackPanel>
        </Grid>

        <!-- Shuffle / sort / genre row -->
        <StackPanel x:Name="FilterRow" Grid.Row="2" Orientation="Horizontal" Spacing="26" Margin="0,20,0,12">
            <Button x:Name="ShuffleAllButton" Style="{StaticResource LinkButton}" Click="ShuffleAll_Click"
                    AutomationProperties.Name="ShuffleAll">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                    <TextBlock x:Name="ShuffleText" FontSize="14" Text="Перемешать все" />
                </StackPanel>
            </Button>
            <StackPanel x:Name="SortBlock" Orientation="Horizontal" Spacing="5">
                <TextBlock Text="Сортировка:" FontSize="14" VerticalAlignment="Center" />
                <Button x:Name="SortButton" Style="{StaticResource LinkButton}" Foreground="{StaticResource GrooveAccentText}">
                    <TextBlock x:Name="SortText" FontSize="14" Text="Дата добавления" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="SortMenu" Placement="Bottom" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <StackPanel x:Name="GenreBlock" Orientation="Horizontal" Spacing="5">
                <TextBlock Text="Жанр:" FontSize="14" VerticalAlignment="Center" />
                <Button x:Name="GenreButton" Style="{StaticResource LinkButton}" Foreground="{StaticResource GrooveAccentText}">
                    <TextBlock x:Name="GenreText" FontSize="14" Text="Все жанры" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="GenreMenu" Placement="Bottom" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <StackPanel x:Name="ScanIndicator" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <ProgressRing Width="14" Height="14" IsActive="True" Foreground="{StaticResource GrooveAccentText}" />
                <TextBlock Text="Добавляем музыку…" FontSize="14" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- "Can't see everything?" banner, shown while the collection is empty -->
        <Grid x:Name="FoldersBanner" Grid.Row="3" Visibility="Collapsed" Margin="0,8,0,0">
            <Rectangle Height="1" VerticalAlignment="Top" Fill="{ThemeResource ContentSeparator}" />
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource ContentSeparator}" />
            <Grid Padding="4,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Не видите всю музыку?" FontSize="14" />
                    <Button Style="{StaticResource LinkButton}" Padding="0,2" Foreground="{StaticResource GrooveAccentText}"
                            Click="ChooseFolders_Click">
                        <TextBlock Text="Укажите, где искать музыку" FontSize="14" />
                    </Button>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource BareButton}" Width="32" Height="32" Click="CloseBanner_Click"
                        AutomationProperties.Name="Закрыть">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Row="4">
            <!-- Songs -->
            <ListView x:Name="SongsList" Visibility="Collapsed" Padding="0,0,0,24" Margin="-12,0,0,0"
                      SelectionMode="Single" DoubleTapped="Songs_DoubleTapped" KeyDown="Songs_KeyDown"
                      ContainerContentChanging="Stripe_ContainerContentChanging"
                      ItemContainerStyle="{StaticResource StretchListItem}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:Track">
                        <Grid Height="48" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Title}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Artist}" FontSize="15" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Album}" FontSize="15" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind YearText}" FontSize="15" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Genre}" FontSize="15" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="{x:Bind DurationText}" FontSize="15" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Artists -->
            <GridView x:Name="ArtistsGrid" Visibility="Collapsed" Padding="0,8,0,24" Margin="-4,0,0,0"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="Artist_Click">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="m:Artist">
                        <StackPanel Width="180" Margin="4,4,8,16" Spacing="8">
                            <Grid Width="180" Height="180">
                                <Ellipse Fill="{ThemeResource TilePlaceholder}" />
                                <FontIcon Glyph="&#xE77B;" FontSize="56" Opacity="0.5" />
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{x:Bind Cover}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="{x:Bind Name}" FontSize="15" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind AlbumCountText}" HorizontalAlignment="Center" Style="{StaticResource SecondaryText}" FontSize="13" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Albums -->
            <GridView x:Name="AlbumsGrid" Padding="0,8,0,24" Margin="-4,0,0,0"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="Album_Click">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="m:Album">
                        <Grid Width="180" Margin="4,4,8,16"
                              PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="180" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Background="{ThemeResource TilePlaceholder}">
                                <FontIcon Glyph="&#xE93C;" FontSize="56" Opacity="0.4" />
                                <Image Source="{x:Bind Cover}" Stretch="UniformToFill" />
                                <Border x:Name="HoverShade" Background="#33000000" Visibility="Collapsed" />
                                <Button x:Name="PlayOverlay" Visibility="Collapsed" Width="40" Height="40" CornerRadius="20"
                                        Style="{StaticResource BareButton}" Margin="0,0,10,10"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Background="#99000000" BorderBrush="White" BorderThickness="1"
                                        Click="PlayAlbum_Click" AutomationProperties.Name="Воспроизвести">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="White" Margin="2,0,0,0" />
                                </Button>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{x:Bind Title}" FontSize="15" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="2" Text="{x:Bind Artist}" Style="{StaticResource SecondaryText}" FontSize="13" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="2,28,0,0" FontSize="20"
                       Text="Здесь пока ничего нет" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
