<Page
    x:Class="Reborn.Pages.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Reborn.Models">

    <Grid>
        <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.15" />
        <Grid Padding="40,24,24,0" ColumnSpacing="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Width="340" Spacing="6">
                <Grid Width="340" Height="340" Background="{ThemeResource TilePlaceholder}" Margin="0,0,0,12">
                    <FontIcon Glyph="&#xE93C;" FontSize="80" Opacity="0.35" />
                    <Image x:Name="Art" Stretch="UniformToFill" />
                </Grid>
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" TextWrapping="WrapWholeWords" MaxLines="2" />
                <TextBlock x:Name="ArtistText" FontSize="16" Style="{StaticResource SecondaryText}" />
                <TextBlock x:Name="AlbumText" Style="{StaticResource SecondaryText}" />
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Очередь" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                           Text="Сейчас ничего не играет. Выберите альбом или композицию в разделе «Моя музыка»." />
                <ListView x:Name="QueueList" Grid.Row="1" Margin="-16,0,0,0" Padding="0,0,0,24"
                          SelectionMode="Single" DoubleTapped="Queue_DoubleTapped" ContainerContentChanging="Stripe_ContainerContentChanging"
                          ItemContainerStyle="{StaticResource StretchListItem}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="m:QueueEntry">
                            <Grid Height="44" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Artist}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
