<Page
    x:Class="Reborn.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="22,20,24,32" Spacing="8" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Настройки" Style="{StaticResource PageHeader}" Margin="0,0,0,16" />

            <TextBlock Text="Музыка на этом компьютере" FontSize="20" />
            <TextBlock Text="Папки, в которых приложение ищет музыку." Style="{StaticResource SecondaryText}" />

            <ItemsControl x:Name="FolderList" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid Padding="0,10" BorderBrush="{ThemeResource ContentSeparator}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Text="{x:Bind}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="32" Height="32"
                                    Tag="{x:Bind}" Click="RemoveFolder_Click" ToolTipService.ToolTip="Удалить папку">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource AccentButtonStyle}" Click="AddFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Добавить папку" />
                    </StackPanel>
                </Button>
                <Button Click="Rescan_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Обновить библиотеку" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Text="Режим" FontSize="20" Margin="0,24,0,0" />
            <RadioButtons x:Name="ThemeRadios" SelectionChanged="Theme_Changed">
                <x:String>Светлый</x:String>
                <x:String>Темный</x:String>
                <x:String>Использовать системный</x:String>
            </RadioButtons>

            <TextBlock Text="О приложении" FontSize="20" Margin="0,24,0,0" />
            <TextBlock x:Name="AboutText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
