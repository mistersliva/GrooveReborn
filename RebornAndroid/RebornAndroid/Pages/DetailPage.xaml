<Page
    x:Class="Reborn.Pages.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Reborn.Models"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with a faint art backdrop -->
        <Grid>
            <!-- A brush, not an Image: the backdrop must not make the header taller -->
            <Border Opacity="0.18">
                <Border.Background>
                    <ImageBrush x:Name="Backdrop" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <Grid x:Name="HeaderGrid" Padding="16,12,16,16" ColumnSpacing="20" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="SquareArt" Width="140" Height="140" Background="{ThemeResource TilePlaceholder}">
                    <FontIcon Glyph="&#xE93C;" FontSize="48" Opacity="0.35" />
                    <Image x:Name="ArtImage" Stretch="UniformToFill" />
                </Grid>
                <Grid x:Name="RoundArt" Width="140" Height="140" Visibility="Collapsed">
                    <Ellipse Fill="{ThemeResource TilePlaceholder}" />
                    <TextBlock x:Name="InitialText" FontSize="56" FontWeight="Light" Opacity="0.6"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush x:Name="RoundBrush" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                    <TextBlock x:Name="TitleText" Style="{StaticResource PageHeader}" FontSize="26" TextWrapping="WrapWholeWords" MaxLines="3" />
                    <TextBlock x:Name="SubText" FontSize="16" Style="{StaticResource SecondaryText}" />
                    <TextBlock x:Name="InfoText" FontSize="13" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource GrooveAccentButton}" Click="PlayAll_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="13" />
                            <TextBlock Text="Воспроизвести все" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GrooveButton}" Click="Shuffle_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B1;" FontSize="13" />
                            <TextBlock Text="Перемешать" FontSize="14" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <ListView x:Name="TrackList" Grid.Row="1" Padding="0,4,0,16"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="Track_Click"
                  ItemContainerStyle="{StaticResource StretchListItem}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:TrackRow">
                    <Grid Height="52" Padding="16,0,16,0" ColumnSpacing="12" Background="{x:Bind Stripe}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind NumberText}" FontSize="14" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Artist}" FontSize="13" Margin="0,1,0,0" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" FontSize="14" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
