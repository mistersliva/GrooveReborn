<Page
    x:Class="Reborn.Pages.MyMusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Reborn.Models"
    NavigationCacheMode="Required"
    Background="Transparent">

    <!-- Groove: header, 20px pivot with a 1px rule under it, 14px filter row -->
    <Grid x:Name="PageRoot" Padding="16,4,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Header" Text="Моя музыка" Style="{StaticResource PageHeader}" Margin="0,0,0,8" />

        <Grid Grid.Row="1">
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource ContentSeparator}" />
            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Tabs" Orientation="Horizontal">
                    <ToggleButton Content="Композиции" Style="{StaticResource PivotTab}" Click="Tab_Click" />
                    <ToggleButton Content="Исполнители" Style="{StaticResource PivotTab}" Click="Tab_Click" />
                    <ToggleButton Content="Альбомы" Style="{StaticResource PivotTab}" Click="Tab_Click" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Shuffle / sort / genre row -->
        <ScrollViewer Grid.Row="2" Margin="0,8,0,4" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FilterRow" Orientation="Horizontal" Spacing="22">
                <Button x:Name="ShuffleAllButton" Style="{StaticResource LinkButton}" Click="ShuffleAll_Click"
                        AutomationProperties.Name="Перемешать все">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                        <TextBlock x:Name="ShuffleText" FontSize="14" Text="Перемешать все" />
                    </StackPanel>
                </Button>
                <StackPanel x:Name="SortBlock" Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Сортировка:" FontSize="14" VerticalAlignment="Center" />
                    <Button x:Name="SortButton" Style="{StaticResource LinkButton}" Foreground="{StaticResource GrooveAccentText}">
                        <TextBlock x:Name="SortText" FontSize="14" Text="Дата добавления" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="SortMenu" Placement="Bottom" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="GenreBlock" Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Жанр:" FontSize="14" VerticalAlignment="Center" />
                    <Button x:Name="GenreButton" Style="{StaticResource LinkButton}" Foreground="{StaticResource GrooveAccentText}">
                        <TextBlock x:Name="GenreText" FontSize="14" Text="Все жанры" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="GenreMenu" Placement="Bottom" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="ScanIndicator" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <ProgressBar Width="40" IsIndeterminate="True" VerticalAlignment="Center" Foreground="{StaticResource GrooveAccentText}" />
                    <TextBlock Text="Добавляем музыку…" FontSize="14" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- "Can't see your music?" banner: shown when access was denied or nothing was found -->
        <Grid x:Name="AccessBanner" Grid.Row="3" Visibility="Collapsed" Margin="0,4,0,4">
            <Rectangle Height="1" VerticalAlignment="Top" Fill="{ThemeResource ContentSeparator}" />
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource ContentSeparator}" />
            <Grid Padding="4,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="BannerText" Text="Не видите всю музыку?" FontSize="14" TextWrapping="Wrap" />
                    <Button Style="{StaticResource LinkButton}" Padding="0,6" Foreground="{StaticResource GrooveAccentText}"
                            Click="GrantAccess_Click">
                        <TextBlock x:Name="BannerLink" Text="Разрешить доступ к музыке" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="4">
            <!-- Songs: tap to play (two lines on a phone, like Groove on Windows 10 Mobile) -->
            <ListView x:Name="SongsList" Visibility="Collapsed" Padding="0,0,0,16" Margin="-16,0,-16,0"
                      SelectionMode="None" IsItemClickEnabled="True" ItemClick="Song_Click"
                      ItemContainerStyle="{StaticResource StretchListItem}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:TrackRow">
                        <Grid Height="56" Padding="16,0,16,0" ColumnSpacing="12" Background="{x:Bind Stripe}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ArtistAlbum}" FontSize="13" Margin="0,2,0,0" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind DurationText}" FontSize="14" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Artists -->
            <ListView x:Name="ArtistsGrid" Visibility="Collapsed" Padding="0,8,0,16" Margin="-4,0,-16,0"
                      SelectionMode="None" Tapped="Tiles_Tapped"
                      ItemContainerStyle="{StaticResource PlainListItem}" ItemTemplate="{StaticResource ArtistTileRow}" />

            <!-- Albums -->
            <ListView x:Name="AlbumsGrid" Padding="0,8,0,16" Margin="-4,0,-16,0"
                      SelectionMode="None" Tapped="Tiles_Tapped"
                      ItemContainerStyle="{StaticResource PlainListItem}" ItemTemplate="{StaticResource AlbumTileRow}" />

            <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="2,28,0,0" FontSize="20"
                       Text="Здесь пока ничего нет" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
