<Page
    x:Class="Reborn.Pages.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Reborn.Models"
    Background="Transparent">

    <Grid>
        <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.15" />
        <Grid x:Name="Layout" Padding="16,8,16,0" ColumnSpacing="48" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Art and track info -->
            <Grid x:Name="InfoPanel" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="ArtBox" Width="140" Height="140" Background="{ThemeResource TilePlaceholder}">
                    <FontIcon Glyph="&#xE93C;" FontSize="48" Opacity="0.35" />
                    <Image x:Name="Art" Stretch="UniformToFill" />
                </Grid>
                <StackPanel x:Name="TextPanel" Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextWrapping="WrapWholeWords" MaxLines="3" />
                    <TextBlock x:Name="ArtistText" FontSize="16" Style="{StaticResource SecondaryText}" />
                    <TextBlock x:Name="AlbumText" Style="{StaticResource SecondaryText}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="QueuePanel" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Очередь" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None"
                           Text="Сейчас ничего не играет. Выберите альбом или композицию в разделе «Моя музыка»." />
                <ListView x:Name="QueueList" Grid.Row="1" Margin="-16,0,-16,0" Padding="0,0,0,16"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="Queue_Click"
                          ItemContainerStyle="{StaticResource StretchListItem}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="m:TrackRow">
                            <Grid Height="52" Padding="16,0,16,0" ColumnSpacing="12" Background="{x:Bind Stripe}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Current track: accent bar on the left edge, like the pane selection -->
                                <Rectangle Width="4" Margin="-16,0,0,0" HorizontalAlignment="Left"
                                           Fill="{StaticResource GrooveAccentText}" Visibility="{x:Bind CurrentVisibility}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Artist}" FontSize="13" Margin="0,1,0,0" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind DurationText}" FontSize="14" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
