<Page
    x:Class="Reborn.Pages.RecentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="16,4,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Последние" Style="{StaticResource PageHeader}" />

        <Button Grid.Row="1" Style="{StaticResource LinkButton}" Margin="0,4,0,0" HorizontalAlignment="Left"
                Click="ShuffleAll_Click" AutomationProperties.Name="Перемешать всю музыку">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                <TextBlock Text="Перемешать всю музыку" FontSize="14" />
            </StackPanel>
        </Button>

        <StackPanel x:Name="EmptyState" Grid.Row="2" Margin="0,24,0,0" Spacing="18">
            <TextBlock Text="Здесь будет показано то, что вы слушаете." FontSize="20" TextWrapping="Wrap" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE93C;" FontSize="24" VerticalAlignment="Top" Margin="2,2,0,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Воспроизвести свою музыку" FontSize="14" />
                    <Button Style="{StaticResource LinkButton}" Padding="0,4" Foreground="{StaticResource GrooveAccentText}"
                            Click="ShowMyMusic_Click">
                        <TextBlock Text="Показать мою музыку" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <ListView x:Name="AlbumsGrid" Grid.Row="2" Padding="0,16,0,16" Margin="-4,0,-16,0"
                  SelectionMode="None" Tapped="Tiles_Tapped"
                  ItemContainerStyle="{StaticResource PlainListItem}" ItemTemplate="{StaticResource AlbumTileRow}" />
    </Grid>
</Page>
