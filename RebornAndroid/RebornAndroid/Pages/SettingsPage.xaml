<Page
    x:Class="Reborn.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="16,4,16,32" Spacing="8" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Настройки" Style="{StaticResource PageHeader}" Margin="0,0,0,16" />

            <TextBlock Text="Музыка на этом устройстве" FontSize="20" />
            <TextBlock Text="Приложение берёт музыку из медиатеки Android: все аудиофайлы во внутренней памяти и на SD-карте."
                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None" />
            <TextBlock x:Name="LibraryText" Margin="0,4,0,4" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AccessButton" Style="{StaticResource GrooveAccentButton}" Click="Access_Click">
                    <TextBlock Text="Разрешить доступ" />
                </Button>
                <Button Style="{StaticResource GrooveButton}" Click="Rescan_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Обновить библиотеку" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <CheckBox x:Name="HideShortBox" Margin="0,8,0,0" Checked="HideShort_Changed" Unchecked="HideShort_Changed">
                <TextBlock Text="Скрывать звуки короче 30 секунд (звуки игр, рингтоны, голосовые)" TextWrapping="Wrap" />
            </CheckBox>

            <TextBlock Text="Режим" FontSize="20" Margin="0,24,0,0" />
            <StackPanel>
                <RadioButton x:Name="ThemeLight" Content="Светлый" GroupName="Theme" Checked="Theme_Checked" Tag="Light" />
                <RadioButton x:Name="ThemeDark" Content="Темный" GroupName="Theme" Checked="Theme_Checked" Tag="Dark" />
                <RadioButton x:Name="ThemeSystem" Content="Использовать системный" GroupName="Theme" Checked="Theme_Checked" Tag="System" />
            </StackPanel>

            <TextBlock Text="О приложении" FontSize="20" Margin="0,24,0,0" />
            <TextBlock x:Name="AboutText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None" />
        </StackPanel>
    </ScrollViewer>
</Page>
